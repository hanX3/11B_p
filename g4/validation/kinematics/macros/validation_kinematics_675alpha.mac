/run/initialize

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# 675-keV resonance beam energy; pure sequential 3-alpha, no direct decay,
# no gamma capture, so every reaction_channel==1 event is a clean
# 12C*->alpha+8Be->alpha+alpha+alpha sequential chain (including the
# SymmetrizedCoherentL1L3 strict model if that is the project default).
/gun/particle proton
/gun/energy 675 keV

/output/saveReaction true
/output/saveEvent false
/output/saveTrack false
/output/saveStep false
/output/printConfig

/h11b/enableDirectDecay false
/h11b/165BWScaleFactor 1.0
/h11b/675ScaleFactor 1.0
/h11b/crossSectionBiasFactor 1000000

/h11b/enable165GammaCapture false
/h11b/enable675GammaCapture false

/h11b/printConfig
/run/beamOn 100000
