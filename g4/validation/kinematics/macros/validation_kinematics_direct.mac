/run/initialize

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Default 165-keV beam; direct decay is a branch of the *total* 165/675
# 3-alpha cross section (see gpt/codex_cs_channel_validation.md), so setting
# both sequential fractions to 0 routes essentially all 3-alpha events
# through GenerateThreeBodyPhaseSpace (reaction_channel==2).
/gun/particle proton
/gun/energy 165 keV

/output/saveReaction true
/output/saveEvent false
/output/saveTrack false
/output/saveStep false
/output/printConfig

/h11b/enableDirectDecay true
/h11b/165SequentialDecayFraction 0.0
/h11b/675SequentialDecayFraction 0.0
/h11b/165BWScaleFactor 1.0
/h11b/675ScaleFactor 1.0
/h11b/crossSectionBiasFactor 1000000

/h11b/enable165GammaCapture false
/h11b/enable675GammaCapture false

/h11b/printConfig
/run/beamOn 100000
