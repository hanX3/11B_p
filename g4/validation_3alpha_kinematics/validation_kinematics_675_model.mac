/run/initialize

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Beam: near 675-keV lab resonance.
/gun/particle proton
/gun/energy 675 keV

# Generator-level ROOT only.
/output/saveReaction true
/output/saveEvent false
/output/saveTrack false
/output/saveStep false
/output/printConfig

# Isolate the two resonance models; no phase-space background in this mode.
/h11b/evaluatedCrossSection model
/h11b/backgroundMode phaseSpace

# Validation-only bias. Not for production physics.
/h11b/crossSectionBiasFactor 1000000000
/h11b/backgroundBiasFactor 1
/h11b/gammaBiasFactor 1

# Three-alpha only.
/h11b/enable165GammaCapture false
/h11b/enable675GammaCapture false

# Keep physical/default angular-correlation settings. Kinematics checks will
# use energy sums, Dalitz variables, opening angles, and momentum closure.
/h11b/enable165PrimaryAngularDistribution false
/h11b/165PrimaryAngularA1 0.0
/h11b/165PrimaryAngularA2 0.0

/h11b/enable165Alpha1SecondaryAngularCorrelation true
/h11b/165Alpha1SecondaryA2 -0.489
/h11b/165Alpha1SecondaryA4 0.647

/h11b/enable165Gamma0AngularDistribution true
/h11b/165Gamma0AngularA1 -0.17757009345794392
/h11b/165Gamma0AngularA2 0.13084112149532712

/h11b/enable675PrimaryAngularDistribution false
/h11b/675PrimaryAngularA1 0.0
/h11b/675PrimaryAngularA2 0.0

/h11b/enable675Alpha1SecondaryAngularCorrelation true
/h11b/675Alpha1SecondaryA2 -1.064
/h11b/675Alpha1SecondaryA4 0.180

/h11b/enable675GammaAngularDistribution false
/h11b/675GammaAngularA1 0.0
/h11b/675GammaAngularA2 0.0

/h11b/printConfig

/run/beamOn 200000
