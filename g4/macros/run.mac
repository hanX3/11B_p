/run/initialize

/control/verbose 2

# ROOT output control
# For generator-level validation, only reaction ROOT output is usually needed.
/output/saveReaction true
/output/saveEvent false
/output/saveTrack false
/output/saveStep false
/output/printConfig


#/tracking/verbose 1
#/hits/verbose 2

# H11B reaction model

# Cross-section decomposition:
#   162 total = 162-keV BW component, optionally scaled by 162BWScaleFactor
#   675 total = fit675 component, optionally scaled by 675ScaleFactor
#   each resonance total is split into sequential and direct-decay branches
#   direct-decay fraction is automatically 1 - sequential-decay fraction
/h11b/enableDirectDecay true
/h11b/162SequentialDecayFraction 0.99
/h11b/675SequentialDecayFraction 0.99
/h11b/162BWScaleFactor 1.0
/h11b/675ScaleFactor 1.0

/h11b/crossSectionBiasFactor 1

# 162-keV primary alpha angular distribution
# false: isotropic diagnostic mode
# true : use W(theta)=1+a1*P1(cos theta)+a2*P2(cos theta)
/h11b/enable162PrimaryAngularDistribution false
/h11b/162PrimaryAngularA1 0.0
/h11b/162PrimaryAngularA2 0.0

# 162-keV alpha1 secondary alpha angular correlation
# Treado 1972, Tp = 0.163 MeV, ignoring theta_s'' = -12 deg shift:
# W(chi)=1+A2*P2(cos chi)+A4*P4(cos chi)
# false: secondary alpha isotropic
# true : use W(chi)=1+A2*P2(cos chi)+A4*P4(cos chi)
/h11b/enable162Alpha1SecondaryAngularCorrelation true
/h11b/162Alpha1SecondaryA2 -0.489
/h11b/162Alpha1SecondaryA4 0.647

# 162-keV gamma0 angular distribution
# false: gamma0 isotropic
# true : use W(theta)=1+a1*P1(cos theta)+a2*P2(cos theta).
# The default A1/A2 values below are equivalent to the previous Craig-1956
# A=0.19, B=0.21 form after normalization.
/h11b/enable162Gamma0AngularDistribution true
/h11b/162Gamma0AngularA1 -0.17757009345794392
/h11b/162Gamma0AngularA2 0.13084112149532712

# 675-keV primary alpha angular distribution
# false: primary alpha isotropic
# true : use W(theta)=1+a1*P1(cos theta)+a2*P2(cos theta)
/h11b/enable675PrimaryAngularDistribution false
/h11b/675PrimaryAngularA1 0.0
/h11b/675PrimaryAngularA2 0.0

# 675-keV alpha1 secondary alpha angular correlation
# Treado 1972, Tp = 0.675 MeV, ignoring theta_s'' = -19 deg shift:
# W(chi)=1+A2*P2(cos chi)+A4*P4(cos chi)
# false: secondary alpha isotropic
# true : use W(chi)=1+A2*P2(cos chi)+A4*P4(cos chi)
/h11b/enable675Alpha1SecondaryAngularCorrelation true
/h11b/675Alpha1SecondaryA2 -1.064
/h11b/675Alpha1SecondaryA4 0.180

# 675-keV alpha-decay final-state generator
# legacyLegendreA2A4        : previous sequential alpha+8Be(2+) + A2/A4 model
# symmetrizedCoherentL1L3   : Kuhlwein-2022-inspired symmetrized coherent L=1/L=3 model
/h11b/675AlphaDecayModel symmetrizedCoherentL1L3
/h11b/675StrictL1Fraction 0.76
/h11b/675StrictL13Phase 4.209734155810323
/h11b/675StrictCoherentL13 true
/h11b/675StrictPermutationSymmetrized true
/h11b/675Strict8BeLambdaEnergyKeV 3037.0
/h11b/675Strict8BeReducedWidthSquaredKeV 1075.0
/h11b/675StrictWeightMaxSafetyFactor 3.0
/h11b/675StrictWeightMaxScanCandidates 2000
/h11b/675StrictMaxSamplingAttempts 10000

/h11b/enable162GammaCapture true
/h11b/enable675GammaCapture true

# 675-keV gamma angular distribution
# false: 675-keV primary gamma isotropic
# true : use W(theta)=1+a1*P1(cos theta)+a2*P2(cos theta)
# Current default is isotropic; keep disabled unless explicit coefficients are available.
/h11b/enable675GammaAngularDistribution false
/h11b/675GammaAngularA1 0.0
/h11b/675GammaAngularA2 0.0

# 675-keV gamma branch selection is fixed internally to the relative line table.
/h11b/gammaBiasFactor 1

/h11b/printConfig

/run/beamOn 2000000
