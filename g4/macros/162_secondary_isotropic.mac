# =====================================================================
# 162_secondary_isotropic.mac
#
# Purpose: 162-keV sequential decay, SECONDARY-alpha energy spectrum and
#          angular distribution, with the alpha1 secondary angular
#          correlation turned OFF (isotropic baseline).
#
#   One run produces BOTH branches (split automatically by partial widths):
#       branch_id = 0  ->  alpha0 channel  (12C* -> a0 + 8Be g.s.)
#       branch_id = 1  ->  alpha1 channel  (12C* -> a1 + 8Be* 2+)
#   Separate the two branches in analysis by cutting on branch_id.
#
# What to read from the reaction tree (secondary alphas = alpha2, alpha3):
#   ENERGY SPECTRUM
#     e_alpha2,     e_alpha3       : secondary-alpha lab kinetic energy (MeV)
#     e_alpha2_cm,  e_alpha3_cm    : secondary-alpha c.m. kinetic energy (MeV)
#   ANGULAR DISTRIBUTION
#     cos_theta_secondary_correlation : cos(theta'') of the 8Be break-up
#                                       (Treado angle, relative to sym. axis)
#     cos_chi_secondary_8be           : secondary alpha vs 8Be recoil axis
#     opening_angle_alpha23_cm        : opening angle of the two secondary a's
#   BOOKKEEPING (to confirm the switch state)
#     secondary_angular_model  : 0 = isotropic, 1 = Legendre A2/A4
#     secondary_a2_used, secondary_a4_used : coefficients actually applied
#     branch_id                : 0 = alpha0, 1 = alpha1
#
# Expectation with correlation OFF:
#   alpha0 secondaries: isotropic  (8Be 0+, always isotropic anyway)
#   alpha1 secondaries: isotropic  (correlation disabled -> flat W)
#   -> both branches give a flat cos(theta'') distribution here.
# =====================================================================

/run/initialize

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/gun/particle proton
/gun/energy 162 keV

# --- output: only the reaction tree is needed ---
/output/saveReaction true
/output/saveEvent false
/output/saveTrack false
/output/saveStep false

# --- open the cross section wide (rate only; kinematics untouched) ---
/h11b/crossSectionBiasFactor 1000000000

# --- force sequential decay so alpha0 AND alpha1 are produced ---
/h11b/enableDirectDecay false
/h11b/162SequentialDecayFraction 1.0

# --- turn off competing gamma channels for a clean sample ---
/h11b/enable162GammaCapture false
/h11b/enable675GammaCapture false

# --- primary angular distribution: irrelevant for these observables ---
#     (spectra are pure kinematics; secondary correlation is set below)
/h11b/enable162PrimaryAngularDistribution false

# --- SECONDARY alpha1 angular correlation: OFF (isotropic baseline) ---
/h11b/enable162Alpha1SecondaryAngularCorrelation false

/h11b/printConfig
/output/printConfig

# ~1e6 events: alpha1 ~95%, alpha0 ~5% (~5e4), plenty for both branches.
/run/beamOn 1000000
