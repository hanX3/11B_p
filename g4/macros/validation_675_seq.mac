# =====================================================================
# validation_675_seq.mac
#
# Purpose: generate 675-keV SEQUENTIAL events with the strict
#          permutation-symmetrized coherent L=1/L=3 model,
#          p + 11B -> 12C*(2-) -> alpha1 + 8Be*(2+) -> 3 alpha,
#          for the primary-alpha energy spectrum (slide: 675 primary a).
#
# Key switches:
#   675SequentialDecayFraction 1.0        -> no direct 3-alpha admixture
#   675AlphaDecayModel symmetrizedCoherentL1L3
#   (k, delta, coherence, permutation symmetrization at their
#    Kuhlwein-2022 defaults, set explicitly below for reproducibility)
#
# Read from the `reaction` tree:
#   e_alpha1                : primary-alpha LAB kinetic energy (MeV)
#   e_alpha2, e_alpha3      : secondary alphas (8Be* breakup)
#   branch_id               : 1 (alpha1 branch)
#   cos_theta_primary_cm    : primary vs beam axis -- expect FLAT
#                             (equal-m sum, rotational invariance)
#
# Expected spectrum: BROAD primary peak -- the 8Be(2+) width
# (Gamma ~ 1.5 MeV) maps directly onto the alpha1 peak shape,
# in contrast to the narrow alpha0 peak of the 162 resonance.
#
# Notes:
#   * Cross-section bias changes RATE only, not kinematics.
#   * 162 channel shut off for a clean 675 sample.
#   * NOTE: the strict model samples the primary direction from the
#     full amplitude; the Legendre knobs
#     /h11b/enable675PrimaryAngularDistribution etc. act only on the
#     legacy generator and are irrelevant here.
# =====================================================================

/run/initialize

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/gun/particle proton
/gun/energy 675 keV

# --- output: only the reaction tree is needed ---
/output/saveReaction true
/output/saveEvent false
/output/saveVirtualSphere false

# --- open the cross section wide (rate only; kinematics untouched) ---
/h11b/crossSectionBiasFactor 1000000000

# --- force the sequential channel; direct 3-alpha off ---
/h11b/enableDirectDecay false
/h11b/675SequentialDecayFraction 1.0
/h11b/675ScaleFactor 1.0

# --- strict permutation-symmetrized coherent L=1/L=3 model ---
/h11b/675AlphaDecayModel symmetrizedCoherentL1L3
/h11b/675StrictL1Fraction 0.76
/h11b/675StrictL13Phase 4.209734155810323
/h11b/675StrictCoherentL13 true
/h11b/675StrictPermutationSymmetrized true
/h11b/675Strict8BeLambdaEnergyKeV 3037.0
/h11b/675Strict8BeReducedWidthSquaredKeV 1075.0
/h11b/675StrictWeightMaxSafetyFactor 3.0
/h11b/675StrictWeightMaxScanCandidates 2000
/h11b/675StrictMaxSamplingAttempts 10000

# --- isolate the 675 resonance: shut the 162 channel down ---
/h11b/162SequentialDecayFraction 1.0
/h11b/162BWScaleFactor 0.0

# --- turn off gamma-capture competition for a clean 3a sample ---
/h11b/enable162GammaCapture false
/h11b/enable675GammaCapture false

/h11b/printConfig
/output/printConfig

/run/beamOn 1000000
